[worldserver]

# SoloCollections: account collections and cosmetic transmogrification.
# Riding training, mount speeds, cast interruption and flight rules belong
# to the server core. This module provides no overrides for those rules.
# Migration-only and inherited NPC/subscription options are documented in
# docs/CONFIGURATION.md and are omitted from this production template.

# Cpp is the production collection owner. Preview primes journal models.
SoloCollections.Backend = Cpp
SoloCollections.Preview.Enabled = 1

# Wardrobe appearance rules (cosmetic only).
# MixedArmor: same / lower / any. MixedWeapons: same / family / any.
# family: 1H axe/sword/mace/fist; 2H axe/sword/mace/staff/polearm;
# bow/gun/crossbow. Source class and weapon proficiency still apply.
# Invalid values fall back to same. Two-hand and ranged groups stay separate.
SoloCollections.Transmog.MixedArmor = any
SoloCollections.Transmog.MixedWeapons = family

Transmogrification.Enable = 1
Transmogrification.AllowHiddenTransmog = 1

# Cost per changed, non-hide slot:
# max(source SellPrice, 10000) * ScaledCostModifier + CopperCost.
# Hide and clear are free in the wardrobe. Set both values to 0 for free apply.
Transmogrification.ScaledCostModifier = 1.0
Transmogrification.CopperCost = 0

# Optional item cost for appearance application.
Transmogrification.RequireToken = 0
Transmogrification.TokenEntry = 49426
Transmogrification.TokenAmount = 1

# Source and target appearance quality eligibility.
Transmogrification.AllowPoor = 1
Transmogrification.AllowCommon = 1
Transmogrification.AllowUncommon = 1
Transmogrification.AllowRare = 1
Transmogrification.AllowEpic = 1
Transmogrification.AllowLegendary = 0
Transmogrification.AllowArtifact = 0
Transmogrification.AllowHeirloom = 1
Transmogrification.AllowFishingPoles = 0

# Item entry overrides for appearance eligibility (space-separated IDs).
Transmogrification.Allowed = ""
Transmogrification.NotAllowed = ""

# Shared cosmetic compatibility rules, also used by the optional NPC interface.
Transmogrification.AllowMixedArmorTypes = 1
Transmogrification.AllowMixedWeaponTypes = 1
Transmogrification.AllowMixedOffhandArmorTypes = 0
Transmogrification.AllowMixedWeaponHandedness = 0
